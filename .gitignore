node_modules/
dist/
build/

# 环境变量（示例文件例外）
.env
.env.local
.env.*
!.env.example

# 运行期数据：数据库 / 上传文件 / 评测数据 / 备份，全部不入库
data/*
!data/.gitkeep
!data/README.md
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 日志与缓存
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.cache/

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json

# 本地临时文件
tmp/
temp/
coverage/

# 系统垃圾文件
**/.DS_Store
.DS_Store
Thumbs.db

# Scratch 编辑器（构建时用 npm run fetch:scratch 拉取，不进版本库）
apps/web/public/scratch-editor/
