# ---------------------------------------------------------------------------
# OGOJ - Oganesson Online Judge
# Copy this file to `.env` and adjust the values before deploying.
# ---------------------------------------------------------------------------

# --- Basic ---------------------------------------------------------------
NODE_ENV=production
# Host / port the HTTP API + built frontend are served on
HOST=0.0.0.0
PORT=8080

# Public URL of the site (used for absolute links in emails / shares)
SITE_URL=http://localhost:8080

# --- Security ------------------------------------------------------------
# CHANGE THIS. Any long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=please-change-this-to-a-long-random-string
# Session lifetime in days
JWT_EXPIRES_DAYS=14

# --- Database（3.0 起使用 PostgreSQL）------------------------------------
# 完整连接串，例如 postgres://ogoj:password@localhost:5432/ogoj
DATABASE_URL=postgres://ogoj:ogoj@localhost:5432/ogoj
# 连接池大小
DATABASE_POOL_SIZE=10
# 仅用于把旧版 SQLite 数据导入 PostgreSQL（npm run migrate:sqlite）
SQLITE_FILE=./data/ogoj.db

# --- Redis（可选，强烈推荐）---------------------------------------------
# 配置后启用：API 限流共享计数、登录失败锁定、在线人数、首页缓存、评测队列唤醒
# 留空则自动退回内置单机实现，功能不受影响（多实例 / 多进程部署必须配）
REDIS_URL=redis://localhost:6379
# 首页等热点数据的缓存时间（秒），0 表示不缓存
CACHE_TTL_SECONDS=20

# --- 构建加速（可选）-----------------------------------------------------
# 国内服务器构建镜像时把 Debian 源换成镜像站，例如 mirrors.aliyun.com
APT_MIRROR=deb.debian.org

# --- Storage -------------------------------------------------------------
# Where testdata / avatars / uploads live
DATA_DIR=./data

# --- Judge ---------------------------------------------------------------
# Number of submissions judged in parallel by this process
JUDGE_CONCURRENCY=2
# Enable the built-in judge worker inside the API process
JUDGE_ENABLED=true
# Extra sandbox: "none" (rlimit only) or "isolate" (Linux isolate binary)
JUDGE_SANDBOX=none

# --- First run -----------------------------------------------------------
# The default super administrator created by `npm run seed`
ROOT_USERNAME=root
ROOT_PASSWORD=ogoj123456
ROOT_EMAIL=root@ogoj.local
