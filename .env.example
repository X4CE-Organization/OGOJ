# ---------------------------------------------------------------------------
# OGOJ - Oganesson Online Judge
# Copy this file to `.env` and adjust the values before deploying.
# ---------------------------------------------------------------------------

# --- Basic ---------------------------------------------------------------
NODE_ENV=production
# Host / port the HTTP API + built frontend are served on
HOST=0.0.0.0
PORT=8080

# Public URL of the site (used for absolute links in emails / shares)
SITE_URL=http://localhost:8080

# --- Security ------------------------------------------------------------
# CHANGE THIS. Any long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=please-change-this-to-a-long-random-string
# Session lifetime in days
JWT_EXPIRES_DAYS=14

# --- Database ------------------------------------------------------------
# SQLite database file. Relative paths are resolved from the repository root.
DATABASE_FILE=./data/ogoj.db

# --- Storage -------------------------------------------------------------
# Where testdata / avatars / uploads live
DATA_DIR=./data

# --- Judge ---------------------------------------------------------------
# Number of submissions judged in parallel by this process
JUDGE_CONCURRENCY=2
# Enable the built-in judge worker inside the API process
JUDGE_ENABLED=true
# Extra sandbox: "none" (rlimit only) or "isolate" (Linux isolate binary)
JUDGE_SANDBOX=none

# --- First run -----------------------------------------------------------
# The default super administrator created by `npm run seed`
ROOT_USERNAME=root
ROOT_PASSWORD=ogoj123456
ROOT_EMAIL=webmaster@ogoj.local
