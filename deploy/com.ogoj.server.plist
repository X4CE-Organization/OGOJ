<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS 开机自启 / 崩溃自动重启（launchd 用户级服务）

  1. 修改下面的路径与 node 路径（把 USERNAME 换成你的用户名）
  2. 安装并启动：
       cp deploy/com.ogoj.server.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.ogoj.server.plist
  3. 常用命令：
       launchctl list | grep ogoj          # 查看状态
       launchctl kickstart -k gui/$(id -u)/com.ogoj.server   # 重启
       launchctl unload -w ~/Library/LaunchAgents/com.ogoj.server.plist  # 停止并取消自启

  日志：data/logs/ogoj.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ogoj.server</string>

  <key>ProgramArguments</key>
  <array>
    <!-- 建议使用绝对路径的 node，例如 /usr/local/bin/node 或项目自带的 node -->
    <string>/usr/local/bin/node</string>
    <string>/Users/USERNAME/Desktop/OGOJ/apps/server/dist/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/Desktop/OGOJ</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>8080</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Desktop/OGOJ/data/logs/ogoj.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Desktop/OGOJ/data/logs/ogoj.log</string>
</dict>
</plist>
